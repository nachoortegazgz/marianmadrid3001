// Wix Job Scheduler Configuration
// All schedules are UTC. Velo ignores intervals shorter than one hour.
{
  "jobs": [
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanExpiredLocks",
      "description": "Purge expired MM_LOCKS once per hour (UTC).",
      "executionConfig": {
        "cronExpression": "15 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanupExpiredDualCache",
      "description": "Clean expired DualSlotCache pairs once per hour (UTC).",
      "executionConfig": {
        "cronExpression": "20 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "runPendingCompensationsJob",
      "description": "Process booking and fiscal compensations once per hour (UTC).",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "processBookingsServiceSyncJob",
      "description": "Process the durable SERVICIOS_CITA to Wix Bookings sync queue once per hour (UTC).",
      "executionConfig": {
        "cronExpression": "40 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanExpiredDaysCache",
      "description": "Clean AvailabilityDaysCache daily at 01:00 UTC.",
      "executionConfig": {
        "cronExpression": "0 1 * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanExpiredSlotsCache",
      "description": "Clean AvailabilitySlotsCache daily at 01:10 UTC.",
      "executionConfig": {
        "cronExpression": "10 1 * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "verifyNightlyZClosing",
      "description": "Verify prior Madrid business day and record Z closing daily at 01:20 UTC.",
      "executionConfig": {
        "cronExpression": "20 1 * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "prepareManagerPackagesJob",
      "description": "Prepare prior-month PDF and prior-quarter PDF when applicable on the fifth day of each month; never sends email.",
      "executionConfig": {
        "cronExpression": "0 3 5 * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanAuditLogs",
      "description": "Retain audit logs for 90 days and purge older entries every Sunday at 02:00 UTC.",
      "executionConfig": {
        "cronExpression": "0 2 * * 0"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "systemHealthCheck",
      "description": "Run the collection, secret, and ledger health check daily at 07:00 UTC.",
      "executionConfig": {
        "cronExpression": "0 7 * * *"
      }
    }
  ]
}
